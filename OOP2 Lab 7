import tkinter as tk
import cmath
import math

# Functions for calculation and updating history
def update_history(operation, result):
    history.append(f"{operation} = {result}")
    if len(history) > 10:  # Limit history size
        history.pop(0)

def add():
    res = float(entry1.get()) + float(entry2.get())
    result.set(res)
    update_history(f"{entry1.get()} + {entry2.get()}", res)

def subtract():
    res = float(entry1.get()) - float(entry2.get())
    result.set(res)
    update_history(f"{entry1.get()} - {entry2.get()}", res)

def multiply():
    res = float(entry1.get()) * float(entry2.get())
    result.set(res)
    update_history(f"{entry1.get()} * {entry2.get()}", res)

def sin():
    x = float(entry1.get())
    res = cmath.sin(x)
    result.set(res)
    update_history(f"sin({entry1.get()})", res)

def cos():
    x = float(entry1.get())
    res = cmath.cos(x)
    result.set(res)
    update_history(f"cos({entry1.get()})", res)

def tan():
    x = float(entry1.get())
    res = cmath.tan(x)
    result.set(res)
    update_history(f"tan({entry1.get()})", res)

def Root():
    res = float(entry1.get()) ** (1 / float(entry2.get()))
    result.set(res)
    update_history(f"{entry1.get()} root {entry2.get()}", res)

def exponent():
    res = float(entry1.get()) ** float(entry2.get())
    result.set(res)
    update_history(f"{entry1.get()} ^ {entry2.get()}", res)

def remove():
    entry1.delete(0, tk.END)
    entry2.delete(0, tk.END)

def divide():
    try:
        res = float(entry1.get()) / float(entry2.get())
        result.set(res)
        update_history(f"{entry1.get()} / {entry2.get()}", res)
    except ZeroDivisionError:
        result.set("Error! Division by zero.")

def show_history():
    history_window = tk.Toplevel(root)
    history_window.title("History")
    history_text = tk.Text(history_window)
    history_text.pack()
    for item in history:
        history_text.insert(tk.END, item + "\n")

# Create the main window
root = tk.Tk()
root.title("Simple Calculator")

# Create StringVar to hold the result
result = tk.StringVar()
history = []

# Create the layout
tk.Label(root, text="Enter first number:").grid(row=0, column=0)
entry1 = tk.Entry(root)
entry1.grid(row=0, column=1)
tk.Label(root, text="Enter second number:").grid(row=1, column=0)
entry2 = tk.Entry(root)
entry2.grid(row=1, column=1)

# Buttons for operations
tk.Button(root, text="Add", command=add).grid(row=3, column=0)
tk.Button(root, text="Subtract", command=subtract).grid(row=3, column=1)
tk.Button(root, text="Multiply", command=multiply).grid(row=4, column=0)
tk.Button(root, text="Divide", command=divide).grid(row=4, column=1)
tk.Button(root, text="Exp", command=exponent).grid(row=5, column=0)
tk.Button(root, text="Root", command=Root).grid(row=5, column=1)
tk.Button(root, text="Sin", command=sin).grid(row=6, column=0)
tk.Button(root, text="Cos", command=cos).grid(row=6, column=1)
tk.Button(root, text="Tan", command=tan).grid(row=7, column=0)
tk.Button(root, text="Clear", command=remove).grid(row=7, column=1)

# Label to show result
tk.Label(root, text="Result:").grid(row=2, column=0)
result_label = tk.Label(root, textvariable=result)
result_label.grid(row=2, column=1)

# Create a menu bar
menu_bar = tk.Menu(root)
root.config(menu=menu_bar)

# Add a File menu
file_menu = tk.Menu(menu_bar, tearoff=0)
menu_bar.add_cascade(label="Menu", menu=file_menu)
file_menu.add_command(label="History", command=show_history)

# Start the main loop
root.geometry("280x250+800+400")
root.mainloop()

